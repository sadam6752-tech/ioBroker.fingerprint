{
  "i18n": true,
  "type": "tabs",
  "items": {
    "_tabConnection": {
      "type": "panel",
      "label": "Connection",
      "items": {
        "_espHeader": {
          "type": "header",
          "text": "FingerprintDoorbell Device",
          "size": 3
        },
        "espIp": {
          "type": "text",
          "label": "Device IP Address",
          "default": "",
          "help": "IP address of the FingerprintDoorbell (ESP32)",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "espPort": {
          "type": "number",
          "label": "Device Port",
          "default": 80,
          "min": 1,
          "max": 65535,
          "help": "HTTP port of the device WebUI (default: 80)",
          "xs": 12, "sm": 6, "md": 3, "lg": 2, "xl": 2
        },
        "requestTimeout": {
          "type": "number",
          "label": "Request Timeout (ms)",
          "default": 5000,
          "min": 1000,
          "max": 30000,
          "xs": 12, "sm": 6, "md": 3, "lg": 2, "xl": 2
        },
        "_authHeader": {
          "type": "header",
          "text": "Device Authentication",
          "size": 3
        },
        "adminUser": {
          "type": "text",
          "label": "Admin User",
          "default": "",
          "help": "HTTP Basic Auth user of the device WebUI (leave empty if not set)",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "adminPassword": {
          "type": "password",
          "label": "Admin Password",
          "default": "",
          "help": "HTTP Basic Auth password of the device WebUI",
          "visible": true,
          "repeat": false,
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "testConnectionButton": {
          "type": "sendTo",
          "label": "Test Connection",
          "command": "testConnection",
          "variant": "contained",
          "color": "primary",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "_webhookHeader": {
          "type": "header",
          "text": "Webhook Receiver",
          "size": 3
        },
        "_webhookInfo": {
          "type": "staticText",
          "text": "With FingerprintDoorbell firmware >= v0.9.1 the adapter provisions the device automatically (server mode). For firmware v0.9, paste the URLs below into the device settings manually.",
          "xs": 12
        },
        "serverHost": {
          "type": "text",
          "label": "Adapter Host/IP",
          "default": "",
          "help": "IP/host of this ioBroker that the device sends events to. Leave empty for auto-detection.",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "webhookBind": {
          "type": "ip",
          "listenOnAllPorts": true,
          "label": "Webhook Bind IP Address",
          "help": "IP address to bind the webhook receiver to. Select 0.0.0.0 for all interfaces.",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "webhookPort": {
          "type": "number",
          "label": "Webhook Port",
          "default": 8095,
          "min": 1024,
          "max": 65535,
          "help": "Port the adapter listens on for events from the device (default: 8095)",
          "xs": 12, "sm": 6, "md": 3, "lg": 2, "xl": 2
        },
        "restrictToDeviceIp": {
          "type": "checkbox",
          "label": "Accept webhooks only from the device IP",
          "default": false,
          "help": "Reject webhook events coming from any host other than the configured device IP",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "webhookToken": {
          "type": "text",
          "label": "Webhook Token",
          "help": "Shared secret required on incoming events. Auto-generated on first start. Regenerate by clearing this field and saving.",
          "readOnly": true,
          "copyToClipboard": true,
          "xs": 12, "sm": 12, "md": 8, "lg": 6, "xl": 6
        },
        "_matchUrlHint": {
          "type": "pattern",
          "label": "HTTP Match URL (paste into device)",
          "copyToClipboard": true,
          "pattern": "http://<iobroker-ip>:${data.webhookPort}/match?id={id}&name={name}&confidence={confidence}&token=${data.webhookToken}",
          "xs": 12, "sm": 12, "md": 12, "lg": 8, "xl": 8
        },
        "_ringUrlHint": {
          "type": "pattern",
          "label": "HTTP Ring URL (paste into device)",
          "copyToClipboard": true,
          "pattern": "http://<iobroker-ip>:${data.webhookPort}/ring?token=${data.webhookToken}",
          "xs": 12, "sm": 12, "md": 12, "lg": 8, "xl": 8
        },
        "_pollingHeader": {
          "type": "header",
          "text": "Status Polling",
          "size": 3
        },
        "pollingEnabled": {
          "type": "checkbox",
          "label": "Enable Status Polling",
          "default": true,
          "help": "Periodically check whether the device is reachable",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "pollingInterval": {
          "type": "number",
          "label": "Polling Interval (seconds)",
          "default": 30,
          "min": 5,
          "max": 600,
          "disabled": "!data.pollingEnabled",
          "xs": 12, "sm": 6, "md": 3, "lg": 2, "xl": 2
        },
        "_logHeader": {
          "type": "header",
          "text": "Access Log",
          "size": 3
        },
        "accessLogging": {
          "type": "checkbox",
          "label": "Enable access logging",
          "default": false,
          "help": "Write a readable access log entry (granted/denied) to the adapter log for every fingerprint event",
          "xs": 12, "sm": 8, "md": 6, "lg": 4, "xl": 4
        }
      }
    },
    "_tabActions": {
      "type": "panel",
      "label": "Fingerprint Actions",
      "items": {
        "_actionsInfo": {
          "type": "staticText",
          "text": "Map each fingerprint to an ioBroker object. On a match the adapter sets/toggles the target. Load the fingerprints from the device, then choose an object and action per row.",
          "xs": 12
        },
        "loadFingerprintsButton": {
          "type": "sendTo",
          "label": "Load fingerprints from device",
          "command": "loadFingerprints",
          "variant": "contained",
          "color": "primary",
          "useNative": true,
          "xs": 12, "sm": 8, "md": 6, "lg": 4, "xl": 4
        },
        "actions": {
          "type": "table",
          "label": "Match actions",
          "items": [
            {
              "type": "number",
              "attr": "id",
              "title": "ID",
              "width": "8%"
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "22%"
            },
            {
              "type": "objectId",
              "attr": "objectId",
              "title": "Target object",
              "width": "34%"
            },
            {
              "type": "select",
              "attr": "action",
              "title": "Action",
              "width": "12%",
              "default": "set",
              "options": [
                { "value": "set", "label": "Set value" },
                { "value": "toggle", "label": "Toggle" }
              ]
            },
            {
              "type": "text",
              "attr": "value",
              "title": "Value",
              "width": "14%"
            },
            {
              "type": "number",
              "attr": "minConfidence",
              "title": "Min conf.",
              "width": "9%"
            },
            {
              "type": "number",
              "attr": "debounce",
              "title": "Debounce (s)",
              "width": "9%"
            },
            {
              "type": "checkbox",
              "attr": "checkConditions",
              "title": "Conditions",
              "width": "8%"
            },
            {
              "type": "checkbox",
              "attr": "alarm",
              "title": "Alarm",
              "width": "8%"
            },
            {
              "type": "checkbox",
              "attr": "snapshot",
              "title": "Snapshot",
              "width": "8%"
            }
          ],
          "xs": 12
        },
        "_ringHeader": {
          "type": "header",
          "text": "Ring action (unknown finger)",
          "size": 3
        },
        "ringActionObject": {
          "type": "objectId",
          "label": "Ring target object",
          "help": "Object to set when an unknown finger rings. Leave empty to disable.",
          "xs": 12, "sm": 8, "md": 6, "lg": 5, "xl": 5
        },
        "ringActionValue": {
          "type": "text",
          "label": "Ring value",
          "help": "Value written on ring (e.g. true, 1, on, or a number/text)",
          "xs": 12, "sm": 4, "md": 3, "lg": 2, "xl": 2
        },
        "_alarmHeader": {
          "type": "header",
          "text": "Alarm target (panic finger)",
          "size": 3
        },
        "_alarmInfo": {
          "type": "staticText",
          "text": "For rows with the 'Alarm' checkbox enabled, this object is set in addition to the normal action (panic finger: opens the door as usual and triggers an alarm state).",
          "xs": 12
        },
        "alarmActionObject": {
          "type": "objectId",
          "label": "Alarm target object",
          "help": "Object to set when a finger with the Alarm flag matches. Leave empty to disable.",
          "xs": 12, "sm": 8, "md": 6, "lg": 5, "xl": 5
        },
        "alarmActionValue": {
          "type": "text",
          "label": "Alarm value",
          "help": "Value written to the alarm object (e.g. true, 1, on, or a number/text)",
          "xs": 12, "sm": 4, "md": 3, "lg": 2, "xl": 2
        },
        "_snapshotHeader": {
          "type": "header",
          "text": "Snapshot target",
          "size": 3
        },
        "_snapshotInfo": {
          "type": "staticText",
          "text": "For rows with the 'Snapshot' checkbox enabled, this object is set in addition to the normal action. Use it to trigger a script that captures a camera snapshot (e.g. ESP32-CAM) and sends it somewhere.",
          "xs": 12
        },
        "snapshotActionObject": {
          "type": "objectId",
          "label": "Snapshot target object",
          "help": "Object to set when a finger with the Snapshot flag matches. Leave empty to disable.",
          "xs": 12, "sm": 8, "md": 6, "lg": 5, "xl": 5
        },
        "snapshotActionValue": {
          "type": "text",
          "label": "Snapshot value",
          "help": "Value written to the snapshot object (e.g. true, 1, on, or a number/text)",
          "xs": 12, "sm": 4, "md": 3, "lg": 2, "xl": 2
        }
      }
    },
    "_tabConditions": {
      "type": "panel",
      "label": "Conditions",
      "items": {
        "_conditionsInfo": {
          "type": "staticText",
          "text": "Time-based access windows. Enter one or more finger IDs (comma-separated, e.g. 1,2,4). A row allows those fingers only on the checked weekdays within the time range. Enable 'Conditions' for a finger in the Fingerprint Actions tab to enforce them. Multiple rows for the same finger are combined with OR. If a finger has 'Conditions' enabled but no matching row, access is denied. Time ranges may cross midnight (e.g. 22:00–06:00).",
          "xs": 12
        },
        "conditions": {
          "type": "table",
          "label": "Access conditions",
          "items": [
            { "type": "text", "attr": "fingerId", "title": "Finger ID(s)", "tooltip": "One or more finger IDs, comma-separated (e.g. 1,2,4)", "width": "12%" },
            { "type": "checkbox", "attr": "mon", "title": "Mo", "width": "7%" },
            { "type": "checkbox", "attr": "tue", "title": "Di", "width": "7%" },
            { "type": "checkbox", "attr": "wed", "title": "Mi", "width": "7%" },
            { "type": "checkbox", "attr": "thu", "title": "Do", "width": "7%" },
            { "type": "checkbox", "attr": "fri", "title": "Fr", "width": "7%" },
            { "type": "checkbox", "attr": "sat", "title": "Sa", "width": "7%" },
            { "type": "checkbox", "attr": "sun", "title": "So", "width": "7%" },
            { "type": "text", "attr": "timeFrom", "title": "From (HH:MM)", "width": "17%" },
            { "type": "text", "attr": "timeTo", "title": "To (HH:MM)", "width": "17%" }
          ],
          "xs": 12
        }
      }
    },
    "_tabManage": {
      "type": "panel",
      "label": "Manage Fingers",
      "items": {
        "_renameHeader": {
          "type": "header",
          "text": "Rename finger",
          "size": 3
        },
        "_renameId": {
          "type": "number",
          "attr": "_renameId",
          "label": "Finger ID",
          "min": 1,
          "max": 200,
          "doNotSave": true,
          "xs": 6, "sm": 3, "md": 2, "lg": 2, "xl": 2
        },
        "_renameName": {
          "type": "text",
          "attr": "_renameName",
          "label": "New name",
          "doNotSave": true,
          "xs": 12, "sm": 5, "md": 4, "lg": 3, "xl": 3
        },
        "renameButton": {
          "type": "sendTo",
          "label": "Rename",
          "command": "renameFinger",
          "jsonData": "{ \"id\": ${data._renameId}, \"name\": \"${data._renameName}\" }",
          "variant": "contained",
          "color": "primary",
          "xs": 12, "sm": 4, "md": 3, "lg": 2, "xl": 2
        },
        "_backupHeader": {
          "type": "header",
          "text": "Backup & Restore",
          "size": 3
        },
        "_backupInfo": {
          "type": "staticText",
          "text": "Backup stores all fingerprint templates (id, name, template) in a file on the ioBroker host that survives adapter updates. Restore writes them back to the sensor. Save the settings first so the device connection is available.",
          "xs": 12
        },
        "backupButton": {
          "type": "sendTo",
          "label": "Create backup",
          "command": "backupFingerprints",
          "variant": "contained",
          "color": "primary",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        },
        "restoreButton": {
          "type": "sendTo",
          "label": "Restore from backup",
          "command": "restoreFingerprints",
          "variant": "outlined",
          "color": "secondary",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 3
        }
      }
    }
  }
}
